# Read by backend/app/config.py and backend/app/intake/model_adapter.py. Everything works with the
# defaults below: offline, no keys. CRISIS_MODE accepts only "simulation" (no real dispatch exists).
CRISIS_MODE=simulation
DATABASE_PATH=./data/crisis.db

# Optional text-model extraction. Unset key or any failure -> rules-only intake, visible degraded state.
LLM_PROVIDER=template
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Override only for failure drills, e.g. http://127.0.0.1:9 (unreachable, no external call).
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com

# Optional live routing. Default "fixture" uses the recorded OpenStreetMap graph with assumed speeds.
ROUTING_PROVIDER=fixture
ORS_API_KEY=
